{
  "name": "yige-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "db:generate": "drizzle-kit generate",
    "build:pages": "node build-pages.mjs",
    "check:pages": "node verify-pages.mjs",
    "check:syntax": "node --check script.js && node --check editor.js && node --check build-pages.mjs && node --check verify-pages.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "drizzle-orm": "0.45.2",
    "gsap": "^3.13.0",
    "ogl": "^1.0.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.2.7",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1",
    "vinext": "^1.0.0-beta.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-rsc": "^0.5.28",
    "drizzle-kit": "0.31.10",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "wrangler": "^4.92.0"
  }
