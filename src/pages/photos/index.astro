---
import BookLayout from "../../layouts/BookLayout.astro";

const plates = [
  {
    number: "P-001",
    title: "雾峡",
    src: "/assets/about/optimized/mist-gorge-960.avif",
    fullSrc: "/assets/about/optimized/mist-gorge-1600.avif",
    width: 720,
    height: 960,
    alt: "云雾缭绕的峡谷与山间建筑",
    date: "2024.02",
    dateTime: "2024-02",
    place: "地点待录",
    note: "云雾将峡谷与建筑分成近景、远景与一段仍未显影的空白。",
  },
  {
    number: "P-002",
    title: "云野",
    src: "/assets/about/optimized/cloud-meadow-960.avif",
    fullSrc: "/assets/about/optimized/cloud-meadow-1600.avif",
    width: 960,
    height: 676,
    alt: "蓝天白云下的高山草地",
    date: "2024.08",
    dateTime: "2024-08",
    place: "地点待录",
    note: "地平线被草地、山脊和流动的云分成三层。",
  },
  {
    number: "P-003",
    title: "静室",
    src: "/assets/about/optimized/quiet-corner-960.avif",
    fullSrc: "/assets/about/optimized/quiet-corner-1600.avif",
    width: 720,
    height: 960,
    alt: "老建筑内安静的光影与玻璃地面",
    date: "2024.11",
    dateTime: "2024-11",
    place: "地点待录",
    note: "一组安静的直线、反光与老建筑内部被保留的时间。",
  },
  {
    number: "P-004",
    title: "暮色",
    src: "/assets/about/optimized/sunset-gorge-960.avif",
    fullSrc: "/assets/about/optimized/sunset-gorge-1600.avif",
    width: 720,
    height: 960,
    alt: "峡谷之间被夕阳染亮的云层",
    date: "2025.10",
    dateTime: "2025-10",
    place: "地点待录",
    note: "山脊收起亮光，云层在天色完全暗下去之前留下最后的颜色。",
  },
  {
    number: "P-005",
    title: "鸥影",
    src: "/assets/about/optimized/lake-birds-960.avif",
    fullSrc: "/assets/about/optimized/lake-birds-1600.avif",
    width: 720,
    height: 960,
    alt: "湖面上飞过亭子的鸟群",
    date: "2026.02",
    dateTime: "2026-02",
    place: "地点待录",
    note: "鸟群从平静的水面与亭子上方经过，让一帧静景短暂有了速度。",
  },
  {
    number: "P-006",
    title: "月峰",
    src: "/assets/about/optimized/moon-peak-960.avif",
    fullSrc: "/assets/about/optimized/moon-peak-1600.avif",
    width: 723,
    height: 960,
    alt: "白日月亮悬在奇峰之上",
    date: "日期待录",
    dateTime: undefined,
    place: "地点待录",
    note: "白日的月亮与近处峰林同时出现，一近一远，却被收进同一页。",
  },
];
const description = "Roy 的摄影接触印样：以图版编号收录山野、建筑、光影与日常现场。";
const photosJsonLd = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: "接触印样",
  description,
  url: new URL("/photos/", Astro.site || Astro.url).toString(),
  associatedMedia: plates.map((plate) => ({
    "@type": "ImageObject",
    name: `${plate.number} / ${plate.title}`,
    contentUrl: new URL(plate.fullSrc, Astro.site || Astro.url).toString(),
    caption: plate.note,
  })),
};
---

<BookLayout
  title="接触印样｜一册未装订的生活"
  description={description}
  canonical="/photos/"
  image="/assets/about/optimized/mist-gorge-960.avif"
  jsonLd={photosJsonLd}
  page="photos"
>
  <main id="main-content" class="book-page book-page--photos">
    <header class="book-page__hero contact-hero" aria-labelledby="contact-title">
      <div class="contact-hero__copy">
        <p class="contact-hero__kicker">ROLL 001 / FIELD NOTES</p>
        <h1 id="contact-title">接触印样</h1>
        <p>
          六张来自山野、建筑与光线的底片，组成本册的第一卷图版。点击照片可查看已移除原始拍摄信息的高清版；日期与地点不完整的部分会在之后的整理中补齐。
        </p>
      </div>
      <dl class="contact-roll">
        <div class="contact-roll__item">
          <dt>ROLL</dt>
          <dd>001</dd>
        </div>
        <div class="contact-roll__item">
          <dt>PLATES</dt>
          <dd>06</dd>
        </div>
        <div class="contact-roll__item">
          <dt>STATUS</dt>
          <dd>ONGOING</dd>
        </div>
      </dl>
    </header>

    <section class="contact-section" aria-labelledby="contact-sheet-title">
      <header class="contact-section__heading">
        <p>PLATE INDEX / P-001—P-006</p>
        <h2 id="contact-sheet-title">ROLL 001 / 山野、建筑与光</h2>
      </header>

      <ol class="contact-sheet" role="list">
        {plates.map((plate) => (
          <li class="contact-plate">
            <figure class="contact-plate__figure">
              <a
                class="contact-plate__image"
                href={plate.fullSrc}
                aria-label={`查看《${plate.title}》高清版`}
              >
                <img
                  src={plate.src}
                  width={plate.width}
                  height={plate.height}
                  alt={plate.alt}
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <figcaption class="contact-plate__caption">
                <div class="contact-plate__title">
                  <span>{plate.number}</span>
                  <h3>{plate.title}</h3>
                </div>
                <dl class="contact-plate__meta">
                  <div>
                    <dt>日期</dt>
                    <dd>
                      {plate.dateTime ? (
                        <time datetime={plate.dateTime}>{plate.date}</time>
                      ) : (
                        plate.date
                      )}
                    </dd>
                  </div>
                  <div>
                    <dt>地点</dt>
                    <dd>{plate.place}</dd>
                  </div>
                </dl>
                <p>{plate.note}</p>
              </figcaption>
            </figure>
          </li>
        ))}
      </ol>
    </section>

    <aside class="contact-note" aria-labelledby="contact-note-title">
      <p>EDITOR'S NOTE</p>
      <h2 id="contact-note-title">关于这份印样</h2>
      <p>
        这里不追求把所有照片一次展开，而是按“卷”编辑彼此有联系的图像。新照片会先被整理，再进入合适的卷与图版编号。
      </p>
    </aside>
  </main>
</BookLayout>
