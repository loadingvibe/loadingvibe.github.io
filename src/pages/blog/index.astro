---
import BookCatalog from "../../components/book/BookCatalog.astro";
import BlogLayout from "../../layouts/BlogLayout.astro";
import {
  getPublishedPosts,
  uniqueBlogCategories,
  uniqueBlogTags,
} from "../../lib/blog";

const posts = await getPublishedPosts();
const tags = uniqueBlogTags(posts);
const categories = uniqueBlogCategories(posts);
const archivePosts = posts.map((post) => ({
  title: post.title,
  catalogNo: post.catalogNo,
  summary: post.summary,
  category: post.category,
  tags: post.tags,
  href: post.href,
  sourcePath: post.sourcePath,
  routePath: post.routePath,
  readingMinutes: post.readingMinutes,
  date: post.date?.toISOString(),
  updated: post.updated?.toISOString(),
  cover: post.cover,
  featured: post.featured,
}));
const description = "Roy 的公开 Markdown 文章档案，收录生活、工作、学习笔记与长期收藏。";
const blogJsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "有点来电·博客",
  description,
  url: new URL("/blog/", Astro.site || Astro.url).toString(),
  inLanguage: "zh-CN",
  author: {
    "@type": "Person",
    name: "Roy",
  },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.title,
    url: new URL(post.href, Astro.site || Astro.url).toString(),
    ...(post.date ? { datePublished: post.date.toISOString() } : {}),
  })),
};
---

<BlogLayout
  title="全书目录｜一册未装订的生活"
  description={description}
  canonical="/blog/"
  image="/og-you-dian-lai-dian-v1.png"
  jsonLd={blogJsonLd}
>
  <main id="main-content" class="blog-index">
    <section class="blog-hero" aria-labelledby="blog-title">
      <div>
        <p class="blog-kicker">CONTENTS / BOUND FOLIOS</p>
        <h1 id="blog-title">全书目录<span>.</span></h1>
      </div>
      <div class="blog-hero__intro">
        <p>已经想清楚的内容在这里获得永久编号并编入正文。你可以沿章节阅读，也可以从索引中寻找一个词。</p>
        <dl>
          <div><dt>POSTS</dt><dd>{posts.length}</dd></div>
          <div><dt>CATEGORIES</dt><dd>{categories.length}</dd></div>
          <div><dt>TOPICS</dt><dd>{tags.length}</dd></div>
        </dl>
      </div>
    </section>

    <section class="blog-archive-index" aria-label="全部文章">
      <BookCatalog posts={archivePosts} />
    </section>
  </main>
</BlogLayout>
