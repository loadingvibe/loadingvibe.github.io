---
import { render } from "astro:content";
import "katex/dist/katex.min.css";
import ArticleOutline from "../../../components/ArticleOutline.astro";
// Share the profile and category navigation between the desktop and mobile rails.
import BlogSidebar from "../../components/blog/BlogSidebar.astro";
import BlogLayout from "../../layouts/BlogLayout.astro";
import "../../styles/article-reader.css";
import {
  getPublishedPosts,
  type BlogPost,
} from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.flatMap((post) => [
    {
      params: { slug: post.routePath },
      props: { post },
    },
    ...post.aliases.map((alias) => ({
      params: { slug: alias },
      props: { post, redirectTo: post.href },
    })),
  ]);
}

interface Props {
  post: BlogPost;
  redirectTo?: string;
}

const { post, redirectTo } = Astro.props;
if (redirectTo) return Astro.redirect(redirectTo, 301);

const { Content, headings } = await render(post.entry);
const posts = await getPublishedPosts();
const outlineHeadings = headings.filter((heading) => heading.depth >= 1 && heading.depth <= 6);

const canonicalUrl = new URL(post.href, Astro.site || Astro.url).toString();
const coverUrl = post.cover ? new URL(post.cover, Astro.site || Astro.url).toString() : undefined;
const pageTitle = `${post.title}｜loadingvibe`;
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  identifier: post.catalogNo,
  description: post.summary,
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  inLanguage: "zh-CN",
  ...(post.date ? { datePublished: post.date.toISOString() } : {}),
  ...(post.updated ? { dateModified: post.updated.toISOString() } : {}),
  ...(coverUrl ? { image: coverUrl } : {}),
  ...(post.tags.length ? { keywords: post.tags.join(", ") } : {}),
  author: {
    "@type": "Person",
    name: "Roy",
    url: new URL("/", Astro.site || Astro.url).toString(),
  },
  publisher: {
    "@type": "Organization",
    name: "loadingvibe",
    url: new URL("/", Astro.site || Astro.url).toString(),
  },
};
---

<BlogLayout
  title={pageTitle}
  description={post.summary}
  canonical={post.href}
  image={post.cover}
  type="article"
  publishedTime={post.date}
  modifiedTime={post.updated}
  tags={post.tags}
  jsonLd={articleJsonLd}
>
  <main id="main-content" class="blog-reader-page article-reader">
    <div class="reader-mobile-tools" aria-label="阅读辅助工具">
      <details name="reader-tools">
        <summary>Roy · 分类导航</summary>
        <div class="reader-mobile-tools__panel">
          <BlogSidebar posts={posts} currentRoute={post.routePath} />
        </div>
      </details>
      <details name="reader-tools">
        <summary>本文大纲</summary>
        <div class="reader-mobile-tools__panel">
          <ArticleOutline headings={outlineHeadings} articleTitle={post.title} />
        </div>
      </details>
    </div>

    <div class="article-reader__layout">
      <aside class="article-reader__rail article-reader__rail--archive" aria-label="文章档案目录">
        <BlogSidebar posts={posts} currentRoute={post.routePath} />
      </aside>

      <article class="blog-article">
        <header id="article-top">
          <h1>
            <svg
              class="blog-article__title-icon"
              width="40"
              height="40"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M6 3h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" />
              <path d="M8 3v18M12 8h4M12 12h4M12 16h2M2 7h4M2 12h4M2 17h4" />
            </svg>
            <span>{post.title}</span>
          </h1>
        </header>

        {import.meta.env.DEV && <aside class="article-preview-note" aria-label="本地写作预览">
          <strong>{post.entry.data.draft ? "草稿预览 · 不会发布到网站" : "本地预览 · 保存后自动更新"}</strong>
          <p><code>{post.sourceFilePath}</code></p>
          {post.entry.data.authorWarnings.map((warning) => <p>{warning}</p>)}
        </aside>}

        {
          post.cover && (
            <figure class="blog-article__cover">
              <img src={post.cover} alt={`${post.title} 的封面`} loading="eager" decoding="async" />
            </figure>
          )
        }

        <div class="markdown-content">
          <Content />
        </div>

        {import.meta.env.DEV && <details class="article-author-tools">
          <summary>
            <span>AUTHOR TOOLS · 仅仓库作者</span>
            <strong>管理这篇 Markdown</strong>
            <b aria-hidden="true">+</b>
          </summary>
          <div class="article-author-tools__panel">
            <div>
              <p>源文件</p>
              <code>{post.sourceFilePath}</code>
              <small id="author-delete-note">
                删除链接只会打开 GitHub 的确认页；需要登录、仓库权限和最后的提交确认，不会在网站中直接删除。
              </small>
            </div>
            <nav aria-label="作者文件操作">
              <a href={post.githubManageUrl} target="_blank" rel="noreferrer nofollow">
                查看源文件 <span aria-hidden="true">↗</span>
              </a>
              <a
                class="article-author-tools__delete"
                href={post.githubDeleteUrl}
                target="_blank"
                rel="noreferrer nofollow"
                aria-describedby="author-delete-note"
              >
                在 GitHub 删除 <span aria-hidden="true">↗</span>
              </a>
            </nav>
          </div>
        </details>}
      </article>

      <aside class="article-reader__rail article-reader__rail--outline" aria-label="本文大纲">
        <ArticleOutline headings={outlineHeadings} articleTitle={post.title} />
      </aside>
    </div>
  </main>
</BlogLayout>
