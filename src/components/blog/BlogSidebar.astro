---
import { Image } from "astro:assets";
import BlogArchiveTree from "../../../components/BlogArchiveTree.astro";
import avatar from "../../assets/blog/roy-avatar.png";
import type { BlogPost } from "../../lib/blog";
import { blogNavigationSection, createBlogNavigationSections } from "../../lib/blog-navigation";

interface Props {
  posts: BlogPost[];
  currentRoute: string;
}

const { posts, currentRoute } = Astro.props;
const sections = createBlogNavigationSections(posts);
const currentPost = posts.find((post) => post.routePath === currentRoute);
const currentSection = currentPost ? blogNavigationSection(currentPost) : undefined;
---

<div class="blog-sidebar">
  <div class="blog-sidebar__profile">
    <Image
      class="blog-sidebar__avatar"
      src={avatar}
      alt="Roy 的头像"
      width={80}
      height={80}
      widths={[80, 160]}
      sizes="(max-width: 1160px) 64px, 80px"
      loading="eager"
      decoding="async"
    />
    <h2 class="blog-sidebar__name">Roy</h2>
  </div>

  <nav class="blog-sidebar__nav" aria-label="博客分类">
    {sections.map((section, index) => (
      <details
        class="blog-sidebar__group"
        data-section={section.name}
        data-current={section.name === currentSection ? "true" : undefined}
        open={section.name === currentSection || (!currentSection && index === 0)}
      >
        <summary class="blog-sidebar__summary">
          <svg
            class="blog-sidebar__icon"
            data-icon={section.icon}
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            {section.icon === "book" ? (
              <>
                <path d="M12 5.5C9.3 3.8 5.7 3.3 3 4v15c2.7-.7 6.3-.2 9 1.5 2.7-1.7 6.3-2.2 9-1.5V4c-2.7-.7-6.3-.2-9 1.5Z" />
                <path d="M12 5.5v15" />
              </>
            ) : section.icon === "people" ? (
              <>
                <circle cx="9" cy="8" r="3" />
                <path d="M3 20v-1.5a6 6 0 0 1 12 0V20M16 5.2a3 3 0 0 1 0 5.6M21 20v-1.5a6 6 0 0 0-3.5-5.4" />
              </>
            ) : (
              <path d="M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />
            )}
          </svg>
          <span class="blog-sidebar__label">{section.name}</span>
          <svg
            class="blog-sidebar__chevron"
            width="14"
            height="14"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="m5.5 3 5 5-5 5" />
          </svg>
        </summary>
        <div class="blog-sidebar__body">
          {section.posts.length ? (
            <BlogArchiveTree node={section.tree} currentRoute={currentRoute} />
          ) : (
            <p class="blog-sidebar__empty">
              还没有发布的文章
            </p>
          )}
        </div>
      </details>
    ))}
  </nav>
</div>
