---
import { libraryVolumeFor, type LibraryVolumeKey } from "../../lib/library";

interface Props {
  page?: LibraryVolumeKey;
}

const { page = "about" } = Astro.props;
const volume = libraryVolumeFor(page);
const label = volume?.navLabel || "内容";
---

<header class="book-return-bar">
  <a class="book-return-link" href="/?library=1#library" aria-label={`从${label}返回书架`}>
    <svg viewBox="0 0 20 20" aria-hidden="true">
      <path d="m11.75 4.75-5.25 5.25 5.25 5.25"></path>
    </svg>
    <span>返回书架</span>
  </a>
</header>
