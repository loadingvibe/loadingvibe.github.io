---
import { deploymentBuild, formatDeploymentBuild } from "../../lib/deployment-build.mjs";

interface Props {
  folios?: number;
  compact?: boolean;
}

const { folios, compact = false } = Astro.props;
const buildDate = formatDeploymentBuild(deploymentBuild.builtAt);
---

<footer class:list={["book-colophon", { "book-colophon--compact": compact }]}>
  <div class="book-colophon__title">
    {!compact && <p>LOADINGVIBE / END</p>}
    <h2>下次见。</h2>
  </div>
  <dl>
    {!compact && <div><dt>STATUS</dt><dd>2026—ONGOING</dd></div>}
    {!compact && typeof folios === "number" && <div><dt>FOLIOS</dt><dd>{String(folios).padStart(2, "0")}</dd></div>}
    <div>
      <dt>LAST BUILD</dt>
      <dd>
        {deploymentBuild.builtAt
          ? <time datetime={deploymentBuild.builtAt} title="部署版本构建时间（北京时间）">{buildDate}</time>
          : buildDate}
      </dd>
    </div>
  </dl>
  <nav aria-label="版本与订阅">
    <a href="/rss.xml">RSS</a>
    <a href="https://github.com/loadingvibe" target="_blank" rel="noreferrer">GitHub</a>
    <a href="mailto:8212230801@csu.edu.cn">Email</a>
    <a href="#main-content">回到本页顶部 ↑</a>
  </nav>
  <p class="book-colophon__note">文字、代码与仍在形成的想法，会在这里继续更新。</p>
</footer>
