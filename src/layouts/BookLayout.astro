---
import BookFooter from "../components/book/BookFooter.astro";
import BookHeader from "../components/book/BookHeader.astro";
import "../styles/book.css";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  canonical?: string | URL;
  image?: string | URL;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  page?: "cover" | "about" | "photos" | "leaves" | "blog" | "marginalia";
  folios?: number;
  plates?: number;
  showFooter?: boolean;
}

const {
  title,
  description,
  canonical,
  image,
  type,
  publishedTime,
  modifiedTime,
  tags,
  jsonLd,
  page = "cover",
  folios,
  plates,
  showFooter = true,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image={image}
  type={type}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  tags={tags}
  jsonLd={jsonLd}
  bodyClass={`book-site book-site--${page}`}
>
  <BookHeader page={page} />
  <slot />
  {showFooter && <BookFooter folios={folios} plates={plates} />}
</BaseLayout>

