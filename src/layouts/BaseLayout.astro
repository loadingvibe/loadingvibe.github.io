---
import "../../site.css";

interface Props {
  title: string;
  description: string;
  canonical?: string | URL;
  image?: string | URL;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
}

const {
  title,
  description,
  canonical,
  image = "/assets/brand/optimized/og-unbound-edition-v1.jpg",
  type = "website",
  publishedTime,
  modifiedTime,
  tags = [],
  jsonLd,
  bodyClass,
} = Astro.props;

const siteBase = Astro.site || Astro.url;
const canonicalUrl = new URL(canonical || Astro.url.pathname, siteBase).toString();
const imageUrl = image ? new URL(image, siteBase).toString() : undefined;
const rssUrl = new URL("/rss.xml", siteBase).toString();
const structuredData =
  jsonLd ||
  ({
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "有点来电",
    url: canonicalUrl,
    description,
    inLanguage: "zh-CN",
  } satisfies Record<string, unknown>);
const safeStructuredData = JSON.stringify(structuredData).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="有点来电·文章 RSS" href={rssUrl} />
    <link rel="icon" type="image/png" href="/assets/brand/optimized/favicon-64.png" />

    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="有点来电" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <script is:inline type="application/ld+json" set:html={safeStructuredData}></script>
  </head>
  <body class={bodyClass}>
    <a class="site-skip-link" href="#main-content">跳到正文</a>
    <slot />
  </body>
</html>
