---
interface ArchivePostLink {
  href: string;
  routePath: string;
  title: string;
  dateLabel: string;
  dateTime?: string;
}

export interface ArchiveTreeNode {
  label: string;
  path: string;
  total: number;
  posts: ArchivePostLink[];
  children: ArchiveTreeNode[];
}

interface Props {
  node: ArchiveTreeNode;
  currentRoute: string;
  level?: number;
}

const { node, currentRoute, level = 0 } = Astro.props;

function firstArticleHref(branch: ArchiveTreeNode): string | undefined {
  return branch.posts[0]?.href || branch.children.map(firstArticleHref).find(Boolean);
}
---

<ul class="article-archive-tree" data-level={level}>
  {
    node.posts.map((item) => (
      <li class="article-archive-tree__post">
        <a
          class:list={{ "is-current": item.routePath === currentRoute }}
          href={item.href}
          aria-current={item.routePath === currentRoute ? "page" : undefined}
        >
          <span>{item.title}</span>
          <time datetime={item.dateTime}>{item.dateLabel}</time>
        </a>
      </li>
    ))
  }

  {
    node.children.map((child) => (
      <li class="article-archive-tree__branch">
        <div class="article-archive-tree__directory">
          <a
            href={firstArticleHref(child)}
            aria-label={`阅读“${child.label}”目录的首篇文章`}
          >
            <span aria-hidden="true">/ </span>{child.label}
          </a>
        </div>
        <Astro.self node={child} currentRoute={currentRoute} level={level + 1} />
      </li>
    ))
  }
</ul>
