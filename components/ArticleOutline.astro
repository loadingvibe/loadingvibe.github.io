---
import ArticleOutlineBranch, { type OutlineNode } from "./ArticleOutlineBranch.astro";

interface OutlineHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: OutlineHeading[];
  articleTitle: string;
}

const { headings, articleTitle } = Astro.props;
const tree: OutlineNode[] = [];
const stack: OutlineNode[] = [];

for (const heading of headings) {
  if (heading.depth < 1 || heading.depth > 6 || !heading.slug) continue;
  const node: OutlineNode = { ...heading, children: [] };
  while (stack.length && stack[stack.length - 1].depth >= heading.depth) stack.pop();
  const parent = stack[stack.length - 1];
  if (parent) parent.children.push(node);
  else tree.push(node);
  stack.push(node);
}
---

<nav class="article-outline" data-article-outline aria-label={`《${articleTitle}》的大纲`}>
  <header class="article-outline__header">
    <h2 class="article-outline__title">大纲</h2>
    <div class="article-outline__tools">
      <button
        class="article-outline__visibility"
        data-outline-visibility
        type="button"
        aria-label="隐藏大纲"
        aria-pressed="false"
        title="隐藏大纲"
        hidden
      >
        <svg data-outline-eye width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
          <circle cx="12" cy="12" r="3" />
        </svg>
        <span data-outline-eye-off hidden>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="m3 3 18 18M10.6 5.1A13 13 0 0 1 12 5c6.5 0 10 7 10 7a17.7 17.7 0 0 1-3.2 4.2M6.2 6.2A19.7 19.7 0 0 0 2 12s3.5 7 10 7a12.6 12.6 0 0 0 5.1-1.1M9.9 9.9a3 3 0 0 0 4.2 4.2" />
          </svg>
        </span>
      </button>
      <button
        class="article-outline__collapse-all"
        data-outline-collapse-all
        type="button"
        aria-label="折叠全部标题"
        aria-pressed="false"
        title="折叠全部标题"
        hidden
      >
        <svg data-outline-collapse-icon width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M10 7h10M10 17h10" />
          <path d="M3 5h5L5.5 9ZM3 15h5l-2.5 4Z" fill="currentColor" stroke="none" />
        </svg>
        <span data-outline-expand-icon hidden>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M10 7h10M10 17h10" />
            <path d="m3.5 4.5 4 2.5-4 2.5Zm0 10 4 2.5-4 2.5Z" fill="currentColor" stroke="none" />
          </svg>
        </span>
      </button>
    </div>
  </header>

  <ol class="article-outline__tree" data-outline-tree>
    {tree.map((node) => <ArticleOutlineBranch node={node} />)}
  </ol>
  {!tree.length && (
    <p class="article-outline__empty" data-outline-tree>这篇文章没有额外的标题。</p>
  )}
</nav>

<script src="../src/scripts/article-outline.ts"></script>
